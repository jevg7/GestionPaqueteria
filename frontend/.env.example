# Copiar como .env.local (no se versiona) y completar.

# API del backend: siempre https (por http la API redirige y el preflight de CORS falla).
VITE_API_URL=https://localhost:7225

# Supabase (Project Settings → API Keys). Solo la clave publicable, nunca la secreta (sb_secret_…).
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
