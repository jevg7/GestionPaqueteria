# Variables de la API en producción (docs/despliegue.md). Copiar a /etc/paqueteria/api.env en el servidor y completar;
# ese archivo tiene secretos y nunca va al repositorio:
#   sudo install -m 600 -o root -g root api.env.example /etc/paqueteria/api.env
# Formato de systemd: CLAVE=valor, una por línea; las comillas dobles permiten el ";" de las cadenas de conexión.
# ASPNETCORE_ENVIRONMENT y ASPNETCORE_URLS ya los fija deploy/systemd/paqueteria-api.service.

# Usuario de la API (miembro de paqueteria_api), nunca el dueño del esquema. Pooler de Supabase en modo SESIÓN (5432),
# nunca transacción (6543). Usuario con la referencia del proyecto: paqueteria_api_app.<ref>. VerifyFull valida el
# certificado contra la CA de Supabase (Database → Settings → SSL Configuration → Download certificate). Maximum Pool
# Size por debajo del Pool Size del pooler (en modo sesión cada conexión ocupa una).
ConnectionStrings__Paqueteria="Host=aws-1-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=paqueteria_api_app.<ref>;Password=<contraseña>;SSL Mode=VerifyFull;Root Certificate=/etc/paqueteria/supabase-ca.crt;Maximum Pool Size=10;Application Name=paqueteria-api"

# Supabase Auth (no son secretos).
Auth__Issuer=https://<ref>.supabase.co/auth/v1
Supabase__Url=https://<ref>.supabase.co
Supabase__InviteRedirectUrl=https://<dominio>/aceptar-invitacion

# SECRETO: administra todas las cuentas de Supabase Auth (invitaciones). Solo aquí.
Supabase__ServiceRoleKey=<sb_secret_…>

# Correo del dueño de la plataforma: su cuenta se crea al iniciar sesión por primera vez.
Plataforma__Propietarios__0=<correo>

# Vacío: el frontend se sirve desde el mismo dominio (deploy/nginx/paqueteria.conf). Solo si viviera en otro:
# Cors__AllowedOrigins__0=https://<otro-dominio>
